# Copy to .env.local for local work. Never commit .env.local.
# Every value is optional: without Supabase the lead API runs in mock mode (validates, returns 201, stores nothing).

# Public (baked into the browser bundle at build time)
NEXT_PUBLIC_SITE_URL=https://cybersentinelpro.com
# Full 40-50 question assessment; the result screen hides the link when empty.
NEXT_PUBLIC_DEEP_AUDIT_URL=
# Cal.com path such as "your-handle/appel-resultats"; when empty the result screen promises an email instead.
NEXT_PUBLIC_CALCOM_LINK=
# none | vercel | plausible. Loaded only after the visitor opts in.
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
# Published on the privacy page and in the footer. The mailbox must exist before launch.
NEXT_PUBLIC_PRIVACY_OFFICER_EMAIL=confidentialite@cybersentinelpro.com

# Server only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# n8n / GoHighLevel webhook, signed with HMAC-SHA256 (SPEC §11). Secret: 16+ characters.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
# Lead notification email is stubbed in v1 and sends nothing even when set.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
